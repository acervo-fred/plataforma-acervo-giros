rules_version = '2';

// ============================================================
// Regras do Firestore — projeto giros-imagens
// (compartilhado pela Plataforma Acervo Giros e pelo Catálogo
// Projetos Giros — coleções isoladas por prefixo, sem colisão)
// ============================================================
// Leitura livre pra todo mundo no Acervo (uso interno da equipe, sem
// exigir login pra consultar). Escrita só pra quem estiver logado com
// uma das contas Google autorizadas abaixo.
//
// O Catálogo (catalogo_projetos) é diferente: fica restrito também
// pra LEITURA, já que reúne links/senhas de material de clientes —
// só quem estiver logado com conta autorizada consegue ler.
//
// Obs.: o Firestore não permite prefixo em path (ex.: acervo_{x}),
// por isso cada coleção é listada explicitamente.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function emailAutorizado() {
      return request.auth != null && request.auth.token.email in [
        "acervo@girostraffic.page",
        "gabrielscmiranda@gmail.com",
        "datamanager@girostraffic.page",
        "assistente.extra@girostraffic.page",
        "assistente.principal@girostraffic.page",
        "assistente@giros.com.br",
        "producao.finalizacao@giros.com.br"
      ];
    }

    match /acervo_projetos/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_midias/{document=**}     { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_estrutura/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_historico/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_demandas/{document=**}   { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_fitas/{document=**}      { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_config/{document=**}     { allow read: if true; allow write: if emailAutorizado(); }

    // Organização — herdado do protótipo "Avaliação do Acervo".
    match /acervo_organizacaoGlossario/{document=**}         { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_organizacaoMetadados/{document=**}         { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_organizacaoProjetosFaltantes/{document=**} { allow read: if true; allow write: if emailAutorizado(); }

    // Catálogo Projetos Giros — mesmo projeto Firebase, coleção isolada.
    // Restrito (leitura E escrita) — ao contrário do Acervo, aqui nem
    // a leitura é livre: só conta Google autorizada.
    match /catalogo_projetos/{document=**} { allow read, write: if emailAutorizado(); }

    // Nada mais é exposto (RTDB é outro banco e não é afetado por isto).
  }
}
