rules_version = '2';

// ============================================================
// Regras do Firestore — projeto giros-imagens
// (compartilhado pela Plataforma Acervo Giros e pelo Catálogo
// Projetos Giros — coleções isoladas por prefixo, sem colisão)
// ============================================================
// Leitura livre pra todo mundo no Acervo (uso interno da equipe, sem
// exigir login pra consultar). Escrita só pra quem estiver logado com
// uma das contas Google autorizadas abaixo.
//
// O Catálogo (catalogo_projetos) é diferente: fica restrito também
// pra LEITURA, já que reúne links/senhas de material de clientes —
// só quem estiver logado com conta autorizada consegue ler. Além
// disso, o Catálogo tem autorização em DUAS camadas (leitor/editor),
// gerenciada dentro do próprio app (tela "Acessos", admin
// acervo@girostraffic.page) via a coleção catalogo_authorizedEmails
// — ver bloco próprio mais abaixo. Isso é independente da lista fixa
// abaixo, que continua sendo só do Acervo.
//
// Obs.: o Firestore não permite prefixo em path (ex.: acervo_{x}),
// por isso cada coleção é listada explicitamente.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function emailAutorizado() {
      return request.auth != null && request.auth.token.email in [
        "acervo@girostraffic.page",
        "gabrielscmiranda@gmail.com",
        "datamanager@girostraffic.page",
        "assistente.extra@girostraffic.page",
        "assistente.principal@girostraffic.page",
        "assistente@giros.com.br",
        "producao.finalizacao@giros.com.br"
      ];
    }

    // ---- Catálogo: admin próprio + papel (leitor/editor) por e-mail ----
    function catalogoAdminPrincipal() {
      return request.auth != null && request.auth.token.email == "acervo@girostraffic.page";
    }
    function catalogoPapel() {
      return exists(/databases/$(database)/documents/catalogo_authorizedEmails/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/catalogo_authorizedEmails/$(request.auth.token.email)).data.papel
        : null;
    }
    function catalogoAutorizado() {
      return request.auth != null && (catalogoAdminPrincipal() || catalogoPapel() != null);
    }
    function catalogoEditor() {
      return request.auth != null && (catalogoAdminPrincipal() || catalogoPapel() == "editor");
    }

    match /acervo_projetos/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_midias/{document=**}     { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_estrutura/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_historico/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_demandas/{document=**}   { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_fitas/{document=**}      { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_config/{document=**}     { allow read: if true; allow write: if emailAutorizado(); }

    // Organização — herdado do protótipo "Avaliação do Acervo".
    match /acervo_organizacaoGlossario/{document=**}         { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_organizacaoMetadados/{document=**}         { allow read: if true; allow write: if emailAutorizado(); }
    match /acervo_organizacaoProjetosFaltantes/{document=**} { allow read: if true; allow write: if emailAutorizado(); }

    // Catálogo Projetos Giros — mesmo projeto Firebase, coleção isolada.
    // Restrito (leitura E escrita) — ao contrário do Acervo, aqui nem
    // a leitura é livre. Leitor lê, só editor (ou o admin) escreve.
    match /catalogo_projetos/{document=**} {
      allow read: if catalogoAutorizado();
      allow write: if catalogoEditor();
    }

    // E-mails autorizados no Catálogo (papel leitor/editor) — gerenciado
    // pelo admin principal direto na tela "Acessos" do app.
    match /catalogo_authorizedEmails/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || catalogoAdminPrincipal());
      allow list: if catalogoAutorizado();
      allow write: if catalogoAdminPrincipal();
    }

    // Pedidos de acesso ao Catálogo. Qualquer logado cria/atualiza só o
    // próprio pedido (doc id = uid); qualquer autorizado vê a fila; só
    // o admin principal aprova/recusa.
    match /catalogo_accessRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || catalogoAutorizado());
      allow list: if catalogoAutorizado();
      allow create, update: if request.auth != null && request.auth.uid == uid
                             && request.resource.data.email == request.auth.token.email;
      allow delete: if catalogoAdminPrincipal();
    }

    // Nada mais é exposto (RTDB é outro banco e não é afetado por isto).
  }
}
